{
  "name": "vue-tiptap-editor",
  "author": "hinet",
  "private": true,
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hinet/vue-tiptap-editor"
  },
  "keywords": [
    "Rich Text",
    "tiptap",
    "vue3 editor",
    "ant-design-vue-tiptap",
    "vue3 rich text"
  ],
  "description": "Provides a custom toolbar button extension for the Tiptap editor based on Ant Design Vue 4, supporting component insertion, action triggering, and UI interactions to enhance the rich-text editing experience.",
  "main": "./dist/vue-tiptap-editor.umd.js",
  "style": "./dist/vue-tiptap-editor.css",
  "module": "./dist/vue-tiptap-editor.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue-tiptap-editor.es.js",
      "require": "./dist/vue-tiptap-editor.umd.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:demo": "yarn vite",
    "build:demo": "cd demo && yarn vite build --base=/vue-tiptap-editor-demo/",
    "docs:dev": "cd docs && yarn vitepress dev",
    "docs:build": "cd docs && yarn vitepress build"
  },
  "peerDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tiptap/core": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "@tiptap/vue-3": "^3.11.0",
    "ant-design-vue": "^4.2.6",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "ant-design-vue": "^4.2.6",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.2",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.1.3"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tiptap/core": "^3.11.0",
    "@tiptap/extension-color": "^3.11.0",
    "@tiptap/extension-text-style": "^3.11.0",
    "@tiptap/starter-kit": "^3.11.0",
    "@tiptap/vue-3": "^3.11.0"
  }
}
